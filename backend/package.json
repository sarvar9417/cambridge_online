{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts && tsx src/database/seed-questions.ts",
    "db:inventory": "tsx src/database/inventory.ts",
    "jobs": "tsx src/jobs/start.ts",
    "jobs:corpus": "tsx src/jobs/start-corpus-worker.ts",
    "corpus:readiness": "tsx src/jobs/corpus-readiness-cli.ts",
    "corpus:preflight": "tsx src/jobs/corpus-preflight-cli.ts",
    "corpus:enqueue": "tsx src/jobs/corpus-enqueue-cli.ts",
    "corpus:reference": "tsx src/jobs/reference-ingest-cli.ts"
  },
  "dependencies": {
    "@sparticuz/chromium-min": "^149.0.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "puppeteer-core": "^25.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^1.4.9",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
