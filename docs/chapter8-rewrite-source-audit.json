  "corrections": [
    {
      "page": 206,
      "issue": "Repeated teacher primary key and a duplicate Maths subject label in Table 8.11",
      "treatment": "Use unique teacher keys and consistent illustrative subject rows; do not copy the anomalous printed rows."
    },
    {
      "page": 207,
      "issue": "Abbreviated STUDENT relation omits ClassID",
      "treatment": "Retain ClassID FK to preserve the Student–Class relationship."
    },
    {
      "page": 212,
      "issue": "CHRACTER typo, inconsistent Licence Number spelling and incomplete FK syntax",
      "treatment": "Use consistent identifiers, explicit types and parenthesised FOREIGN KEY columns."
    },
    {
      "page": 213,
      "issue": "AND in SELECT output list and NUL in COUNT explanation",
      "treatment": "Use comma-separated column expressions and distinguish COUNT(*) from COUNT(column), excluding NULL values from the latter."
    },
    {
      "page": 214,
      "issue": "Unquoted strings/ambiguous date literals and DELETE described as deleting the whole table",
      "treatment": "Quote text, use ISO-formatted dates, and distinguish deleting rows from dropping the structure."
    }
  ],
