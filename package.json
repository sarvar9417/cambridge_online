{
  "name": "campath",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,yaml,yml}\"",
    "db:generate": "pnpm --filter @campath/db generate",
    "db:migrate": "pnpm --filter @campath/db migrate",
    "db:seed": "pnpm --filter @campath/db seed",
    "dev": "docker compose up",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
