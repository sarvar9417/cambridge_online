NODE_ENV=development
PORT=3001

# --- Supabase PostgreSQL -----------------------------------------------------
# Project Settings -> Database -> Connection string.
#
# DATABASE_URL is the transaction pooler (port 6543): short-lived, request-scoped
# queries. DIRECT_URL is the direct connection (port 5432) and is used only by
# migrations, which take a session-level advisory lock the pooler cannot honour.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Redis (BullMQ) ----------------------------------------------------------
# Supabase has no Redis. Local: docker compose. Production: Upstash or similar.
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# At least 32 characters. Rotating it invalidates every issued access token.
JWT_SECRET=replace-with-at-least-32-random-characters

WEB_ORIGIN=http://localhost:5173

# --- Supabase Storage (S3 protocol) ------------------------------------------
# Project Settings -> Storage -> S3 access keys.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_BUCKET=campath
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Worker only (R9) --------------------------------------------------------
# Must never be set in the api or web environment.
ANTHROPIC_API_KEY=

# --- Seed --------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@campath.local
SEED_OWNER_PASSWORD=
SEED_TEACHER_EMAIL=teacher@campath.local
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=
