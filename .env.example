NODE_ENV=development
DATABASE_URL=postgresql://campath:campath@localhost:5432/campath
DB_POOL_MAX=10
# Remote PostgreSQL defaults to verify-full. Put the Supabase Database Settings
# root certificate in DB_SSL_CA (PEM) or DB_SSL_CA_BASE64. Local DB ignores this.
DB_SSL_MODE=verify-full
DB_SSL_CA=
DB_SSL_CA_BASE64=
JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
FRONTEND_URL=http://localhost:5173
PORT=3001
# Productionda bo'sh qoldirilsa frontend shu Vercel domenidagi /api/v1 ni ishlatadi.
VITE_API_URL=http://localhost:3001/api/v1
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=replace-with-a-strong-password
SEED_STUDENT_PASSWORD=replace-with-a-strong-password
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
EXPORT_DIR=storage/exports
# Faza 2+ production capability'lari. Bo'sh bo'lsa /ready da false ko'rinadi.
ANTHROPIC_API_KEY=
PDFTOTEXT_PATH=/usr/local/bin/pdftotext
PDFTOPPM_PATH=/usr/local/bin/pdftoppm
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=
ASSET_STORAGE_BUCKET=question-assets
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
